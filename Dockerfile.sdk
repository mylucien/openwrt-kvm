# Dockerfile.sdk — IP-KVM OpenWRT SDK 交叉编译环境
#
# 构建：
#   docker build -t ipkvm-sdk -f Dockerfile.sdk .
#
# 使用：
#   docker run --rm -v $(pwd):/build ipkvm-sdk ./build.sh mipsel
#
# 支持的目标架构：
#   mipsel  — MT7620/MT7621 系列 (MIPS 小端)
#   mips    — MIPS 大端
#   arm     — ARM 32-bit
#   aarch64 — ARM 64-bit

FROM ubuntu:22.04 AS base

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    xz-utils \
    file \
    && rm -rf /var/lib/apt/lists/*

# ── OpenWRT SDK 安装 ─────────────────────────────
ARG TARGET=mipsel
ARG SDK_URL=""

# 如果不指定 SDK_URL，使用 musl 交叉编译器（简化方案）
RUN if [ -z "$SDK_URL" ]; then \
        apt-get update && apt-get install -y \
            gcc-mipsel-linux-gnu \
            gcc-arm-linux-gnueabi \
            gcc-aarch64-linux-gnu \
            && rm -rf /var/lib/apt/lists/*; \
    fi

COPY . /build
WORKDIR /build

# 默认命令：编译构建
CMD ["./build.sh", "native"]
